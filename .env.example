# 复制为 .env 并填入实际密钥（.env 已被 .gitignore 排除，不会误传）
# 最快的方式：运行 python scripts/setup_deepseek.py，会交互式写入并自动验证连通性
#
# Linux/macOS:  cp .env.example .env
# Windows:      Copy-Item .env.example .env

# ===== DeepSeek（推荐：便宜、中文好、新用户有免费额度）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# ===== 或 OpenAI =====
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# ===== 或本地 Ollama（LLM_API_KEY 填任意非空值）=====
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama

# ===== 可选调优 =====
# 生成温度，0.2 适合要稳定结构的场景
# LLM_TEMPERATURE=0.2
# 单次响应最大 token；若报「空内容」说明被 reasoning token 耗尽，请调大
# LLM_MAX_TOKENS=2048
# 请求超时（秒）
# LLM_TIMEOUT=60
# 失败重试次数
# LLM_MAX_RETRIES=3
